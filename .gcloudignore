# Controls what `gcloud run deploy --source .` uploads to Cloud Build.
# Without this file gcloud falls back to .gitignore semantics only partially,
# and the 594MB .venv plus 60MB of Parquet would be uploaded on every deploy.

.git/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# GUARDRAIL #3: the locked holdout must never ship inside a container image.
# Only eval/holdout_score.py may read it, and that runs locally, never on
# Cloud Run. data/raw is excluded too: the deployed UI reads the committed
# artifacts/demo_run.json instead of re-deriving results from raw Parquet.
data/holdout/
data/raw/
data/cache/

# Local-only files.
.env
.DS_Store
eval/runs/
*.log
AGENTS.md
CLAUDE.md
ac-ai-assistant.md
