%%{init: {"theme":"base","themeVariables":{"fontFamily":"Helvetica,Arial,sans-serif","fontSize":"15px","clusterBkg":"#161b22","clusterBorder":"#30363d","lineColor":"#8b949e","edgeLabelBackground":"#0d1117","textColor":"#c9d1d9","secondaryTextColor":"#c9d1d9","tertiaryColor":"#161b22"}}}%%
flowchart TB
    SCHED(["<b>Cloud Scheduler</b><br/>Mon 09:00 weekly — unattended"]):::infra
    SRC["<b>NASA ASRS corpus</b> — 47,723 reports<br/>train 38,655 · val 4,295 · test LOCKED"]:::data

    subgraph S12["STAGES 1–2 · Deterministic — no LLM call reaches this code"]
        direction LR
        ING["<b>Ingest</b><br/>NASA's own coded<br/>columns → typed record"]:::tool
        EMB["<b>Embeddings + HDBSCAN</b><br/>seeded, reproducible"]:::tool
        ING --> EMB
    end

    subgraph S3["STAGE 3 · Assess — one Analyst call per cluster, not per report"]
        direction LR
        CA["<b>Analyst Agent</b> (LLM)<br/>names the hazard, writes prose<br/><i>does not compute risk</i>"]:::agent
        RISK["<b>Risk scoring</b> — deterministic code<br/>0.5·severity + 0.3·frequency + 0.2·trend"]:::tool
        CA --> RISK
    end

    GATE{"<b>total ≥ 0.60?</b>"}:::gate

    subgraph S4["STAGE 4 · Coordinate — escalated clusters only, plain-Python fan-out"]
        direction LR
        P1["<b>Precedent</b>"]:::agent
        P2["<b>Risk Explainer</b>"]:::agent
        P3["<b>Brief Writer</b>"]:::agent
    end
    DEG{"<b>survivors?</b>"}:::gate

    subgraph S5["STAGE 5 · Verify, then stop"]
        CRIT["<b>Critic Agent</b> (LLM)<br/>removes uncited claims.<br/>A 2-of-3 brief is stamped <b>DEGRADED</b>,<br/>re-asserted by code if the Critic drops it."]:::agent
        HARD["<b>strip_uncited_claims</b> — deterministic<br/>ALWAYS runs last, even if the Critic died.<br/>Validates <i>provenance</i>, not citation shape:<br/>a well-formed ACN from no real report is stripped."]:::tool
        CRIT --> HARD
    end

    DET["<b>Deterministic brief template</b><br/>the cluster is never dropped"]:::tool
    HUMAN["<b>HUMAN APPROVAL — terminal</b><br/>VIGIL drafts and recommends.<br/>It never sends, files, or actions."]:::human
    MEM[("<b>Firestore</b><br/>clusters · escalations · rejections<br/>agent_log: model, tokens, latency")]:::mem
    FROZEN["<b>config/frozen.yaml — FROZEN</b><br/>thresholds loaded read-only.<br/>No agent may retune them,<br/>including the Evaluator."]:::frozen

    SCHED --> SRC --> S12
    EMB --> CA
    RISK --> GATE
    GATE -->|"escalate"| S4
    GATE -->|"below threshold"| MEM
    P1 --> DEG
    P2 --> DEG
    P3 --> DEG
    DEG -->|"3 of 3"| CRIT
    DEG -->|"2 of 3"| CRIT
    DEG -->|"< 2"| DET
    DET --> HARD
    HARD --> HUMAN
    HUMAN --> MEM
    MEM -.->|"member-set Jaccard > 0.6 —<br/>already alerted, stay quiet"| CA
    HUMAN -.->|"rejected = negative example"| MEM
    FROZEN -.->|"read-only"| RISK

    classDef agent fill:#12365a,stroke:#58a6ff,stroke-width:2px,color:#e6edf3
    classDef tool fill:#123d2a,stroke:#3fb950,stroke-width:2px,color:#e6edf3
    classDef data fill:#21262d,stroke:#8b949e,stroke-width:2px,color:#e6edf3
    classDef gate fill:#4d3800,stroke:#d29922,stroke-width:2px,color:#e6edf3
    classDef human fill:#5c1a1a,stroke:#f85149,stroke-width:3px,color:#e6edf3
    classDef mem fill:#2d2159,stroke:#a371f7,stroke-width:2px,color:#e6edf3
    classDef frozen fill:#30363d,stroke:#f85149,stroke-width:2px,color:#e6edf3
    classDef infra fill:#0f3d3d,stroke:#39d3d3,stroke-width:2px,color:#e6edf3
