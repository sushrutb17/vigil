flowchart TD
    SRC["ASRS Corpus<br/>47.7k reports"]:::data

    subgraph S1["STAGE 1 - Ingest / SequentialAgent"]
        EXT["Extractor Agent<br/>narrative to schema"]:::agent
        DED["Dedup Agent<br/>merge same-event reports"]:::agent
        EXT --> DED
    end

    subgraph S2["STAGE 2 - Cluster / deterministic tool"]
        EMB["Embeddings + HDBSCAN<br/>no LLM here"]:::tool
    end

    subgraph S3["STAGE 3 - Analyse / LlmAgent per cluster"]
        CA["Cluster Analyst<br/>name, hazard statement,<br/>risk = severity x freq x trend"]:::agent
        GATE{"Above<br/>threshold?"}:::gate
        CA --> GATE
    end

    subgraph S4["STAGE 4 - Respond / ParallelAgent"]
        COORD["Coordinator Agent"]:::agent
        P1["Precedent Agent<br/>RAG over history"]:::agent
        P2["Risk Agent<br/>score vs matrix"]:::agent
        P3["Brief Writer<br/>investigator brief"]:::agent
        COORD --> P1
        COORD --> P2
        COORD --> P3
    end

    subgraph S5["STAGE 5 - Verify and gate"]
        CRIT["Critic Agent<br/>strip any claim<br/>without a cited ACN"]:::agent
        HUMAN["HUMAN APPROVAL<br/>analyst reviews<br/>system never actions"]:::human
        CRIT --> HUMAN
    end

    MEM[("Memory / Firestore<br/>escalated cluster IDs<br/>prevents re-alerting")]:::mem

    subgraph LOOP["SELF-IMPROVEMENT LOOP - offline, extractor only"]
        EVAL["Evaluator Agent<br/>score vs coded fields"]:::agent
        REV["Prompt Revision<br/>proposed by LLM"]:::agent
        HOLD{"Improves on<br/>LOCKED holdout?"}:::gate
        GUARD["Guard metrics<br/>catch reward hacking"]:::tool
        EVAL --> REV --> HOLD
        HOLD -->|"yes - promote"| GUARD
        HOLD -->|"no - discard"| EVAL
    end

    FROZEN["FROZEN - risk thresholds<br/>never self-tuned<br/>audit requirement"]:::frozen

    SRC --> S1
    DED --> EMB
    EMB --> CA
    GATE -->|"severe"| COORD
    GATE -->|"below"| MEM
    P1 --> CRIT
    P2 --> CRIT
    P3 --> CRIT
    HUMAN --> MEM
    MEM -.->|"already escalated?"| CA
    HUMAN -.->|"rejected cluster<br/>= negative example"| MEM
    EXT -.->|"batch output"| EVAL
    GUARD -.->|"promoted prompt"| EXT
    FROZEN -.-> P2

    classDef agent fill:#1a3d5c,stroke:#4a9eda,stroke-width:2px,color:#fff
    classDef tool fill:#2d4a2d,stroke:#6aba6a,stroke-width:2px,color:#fff
    classDef data fill:#3d3d3d,stroke:#999,stroke-width:2px,color:#fff
    classDef gate fill:#5c4a1a,stroke:#daa54a,stroke-width:2px,color:#fff
    classDef human fill:#5c1a1a,stroke:#da4a4a,stroke-width:3px,color:#fff
    classDef mem fill:#3d2d5c,stroke:#9a7ada,stroke-width:2px,color:#fff
    classDef frozen fill:#4a4a4a,stroke:#da4a4a,stroke-width:2px,color:#fff
