flowchart TB
    SRC["Public NASA ASRS corpus<br/>Parquet reports"]:::data
    ADK["Google ADK + Gemini<br/>Flash operational agents"]:::cloud

    subgraph CLOUD["GOOGLE CLOUD"]
        direction TB

        subgraph BATCH["Cloud Run batch job — deterministic triage"]
            direction LR
            ING["Normalize coded fields<br/>and narratives"]:::tool
            CLUSTER["TF-IDF + seeded HDBSCAN<br/>NO LLM CALLS"]:::tool
            ANALYST["Cluster Analyst<br/>name + hazard statement"]:::agent
            SCORE["Frozen risk policy<br/>severity × frequency × trend"]:::frozen
            ROUTE{"Above fixed<br/>threshold?"}:::gate
            ING --> CLUSTER --> ANALYST --> SCORE --> ROUTE
        end

        subgraph RESPONSE["Escalated clusters only — concurrent fan-out and verification"]
            direction LR
            COORD["Coordinator fan-out<br/>Precedent ∥ Risk ∥ Brief Writer"]:::agent
            CRITIC["Critic Agent<br/>review assembled draft"]:::agent
            CITE["Deterministic citation gate<br/>ACN format + provenance allow-list"]:::security
            PERSIST["Persist reports, clusters,<br/>briefs, decisions, call logs"]:::tool
            COORD --> CRITIC --> CITE --> PERSIST
        end

        DB[("Firestore<br/>state + escalation ledger<br/>per-agent observability")]:::mem
        UI["Cloud Run Streamlit UI<br/>ranked review queue + briefs"]:::frontend

        ROUTE -->|"severe"| COORD
        ROUTE -->|"below threshold"| PERSIST
        PERSIST --> DB --> UI
    end

    HUMAN["HUMAN TERMINAL GATE<br/>approve or reject<br/>system never actions"]:::human
    OFFLINE["PLANNED OFFLINE EXTRACTOR LOOP<br/>validation revisions → guard metrics → LOCKED holdout"]:::planned

    SRC --> ING
    ADK -.-> ANALYST
    ADK -.-> COORD
    ADK -.-> CRITIC
    UI --> HUMAN
    HUMAN -->|"approved / rejected"| DB
    DB -.->|"negative examples"| OFFLINE

    classDef agent fill:#173e63,stroke:#58a6d8,stroke-width:2px,color:#ffffff
    classDef tool fill:#244c2e,stroke:#63b573,stroke-width:2px,color:#ffffff
    classDef data fill:#3d4650,stroke:#9da7b1,stroke-width:2px,color:#ffffff
    classDef gate fill:#684b13,stroke:#e0ad45,stroke-width:2px,color:#ffffff
    classDef human fill:#691f25,stroke:#e05d68,stroke-width:3px,color:#ffffff
    classDef mem fill:#3f2b67,stroke:#9d7dde,stroke-width:2px,color:#ffffff
    classDef frozen fill:#4b3d3d,stroke:#df6a6a,stroke-width:2px,color:#ffffff
    classDef security fill:#3b3558,stroke:#9f8de0,stroke-width:2px,color:#ffffff
    classDef frontend fill:#174b55,stroke:#4fb8c5,stroke-width:2px,color:#ffffff
    classDef cloud fill:#243d62,stroke:#6f9edb,stroke-width:2px,color:#ffffff
    classDef planned fill:#50545b,stroke:#a7adb5,stroke-width:2px,stroke-dasharray:6 4,color:#ffffff
